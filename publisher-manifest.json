rgin-top:14px}\n  .plan.pick{border-color:var(--violet);box-shadow:8px 8px 0 var(--violet-soft)}\n  .plan-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 14px;border-bottom:1px dashed #c2c2cf;padding-bottom:14px;margin-bottom:16px}\n  .plan-head h3{margin:0;font-size:21px;font-weight:800}\n  .plan-head .price{margin-left:auto;font-size:24px;font-weight:800;letter-spacing:-.01em}\n  .plan-head .price small{font-size:13px;font-weight:600;color:var(--muted)}\n  .badge{font-size:11.5px;letter-spacing:.1em;background:var(--violet);color:#fff;padding:3px 9px}\n  .plan .annual{margin:0 0 14px;font-size:14px;color:var(--muted)}\n  .plan ul{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:8px 22px}\n  .plan li{position:relative;padding-left:16px;font-size:15px;color:#2b2b36}\n  .plan li::before{content:\"\";position:absolute;left:0;top:9px;width:7px;height:7px;background:var(--violet)}\n\n  /* 客户端 */\n  .client-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n  .client-grid .card{margin-top:0}\n  .note{margin-top:14px;background:var(--violet-soft);border:2px solid var(--line);padding:14px 18px;font-size:14px;color:#33235e}\n\n  /* FAQ：details 折叠 */\n  details{background:var(--panel);border:2px solid var(--line);padding:0}\n  details + details{margin-top:10px}\n  summary{cursor:pointer;list-style:none;padding:15px 46px 15px 18px;font-weight:700;font-size:15.5px;position:relative}\n  summary::-webkit-details-marker{display:none}\n  summary::after{content:\"+\";position:absolute;right:18px;top:50%;transform:translateY(-50%);color:var(--violet);font-size:19px;font-weight:800;line-height:1}\n  details[open] summary::after{content:\"–\"}\n  details[open] summary{border-bottom:1px dashed #c2c2cf}\n  details .ans{padding:14px 18px 16px;font-size:15px;color:#33333f}\n  details .ans p{margin:0 0 8px}\n  details .ans p:last-child{margin-bottom:0}\n\n  footer{margin-top:56px;border-top:2px solid var(--line);padding-top:18px;font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 20px}\n\n  @media (max-width:860px){\n    .shell{flex-direction:column;padding:0 16px 56px}\n    .side{position:static;flex:none;width:100%;min-height:0;padding:20px 0 14px;border-right:0;border-bottom:1px solid #d5d5dd}\n    .side nav{margin-top:14px}\n    .side nav ol{display:flex;flex-wrap:wrap;gap:4px 6px;font-size:13px}\n    .side nav li{margin:0}\n    .side nav a{padding:4px 10px;border:1.5px solid #c9c9d5;background:var(--panel)}\n    .side nav a:hover{border-left-color:#c9c9d5}\n    .side nav p{margin-bottom:8px}\n    .side .foot{margin-top:14px}\n    main{padding-left:0;width:100%}\n    .t-a,.t-b,.t-c,.t-d,.t-e{grid-column:span 3}\n    .t-c,.t-e{grid-column:span 3}\n    .plan ul{grid-template-columns:1fr}\n    .client-grid{grid-template-columns:1fr}\n    .plan-head .price{margin-left:0}\n  }\n  @media (max-width:440px){\n    .t-a,.t-b,.t-c,.t-d,.t-e{grid-column:span 6}\n    .step{grid-template-columns:36px 1fr;gap:12px;padding:16px}\n    .step .no{font-size:24px}\n  }\n</style><div class=\"shell\">\n\n  <aside class=\"side\">\n    <div class=\"mark\">火云加速<span>huoyunjs</span></div>\n    <nav>\n      <p>目录</p>\n      <ol>\n        <li><a href=\"#plans\">套餐</a></li>\n        <li><a href=\"#clients\">客户端</a></li>\n        <li><a href=\"#howto\">使用方法</a></li>\n        <li><a href=\"#notes\">选购前须知</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ol>\n    </nav>\n    <div class=\"foot\">\n      价格与权益以本页套餐卡为准。<br>\n      页面内容为展示说明，不含下单入口。\n    </div>\n  </aside>\n\n  <main>\n\n    <header class=\"hero\">\n      <div class=\"hero-top\"><i></i>火云加速 · 服务说明页</div>\n      <h1>火云加速(huoyunjs) · 火云加速，把<em>能用多少</em>写清楚</h1>\n      <p class=\"lede\">挑加速服务这件事，最怕的是翻半天找不到关键数字。所以我们把三档套餐的流量、设备数与价格先摆出来，再把客户端怎么装、怎么用、哪些事做不到，一条条写在下面。看完你心里有个数，再决定要不要用。</p>\n\n      <div class=\"dash\">\n        <div class=\"tile t-a\">\n          <div class=\"k\">套餐档位</div>\n          <div class=\"v\">3 <small>档</small></div>\n          <div class=\"n\">基础版 / 旗舰版 / 团队版，按流量和设备数区分，不按速度藏小字。</div>\n        </div>\n        <div class=\"tile t-b\">\n          <div class=\"k\">月付起价</div>\n          <div class=\"v\">¥15 <small>/ 月起</small></div>\n          <div class=\"n\">年付按十个月计价，¥150 起，具体见下方套餐卡。</div>\n        </div>\n        <div class=\"tile t-c\">\n          <div class=\"k\">月流量上限</div>\n          <div class=\"v\">1000 <small>GB</small></div>\n          <div class=\"n\">团队版档位数值，基础版为 100GB。</div>\n        </div>\n        <div class=\"tile t-d\">\n          <div class=\"k\">同时在线设备</div>\n          <div class=\"v\">3 / 5 / 20</div>\n          <div class=\"n\">按档位递增，超出需调整套餐。</div>\n        </div>\n        <div class=\"tile t-e\">\n          <div class=\"k\">计费周期</div>\n          <div class=\"v\">月付 · 年付</div>\n          <div class=\"n\">两种周期并列，不设自动续费说明。</div>\n        </div>\n      </div>\n    </header>\n\n    <section id=\"plans\">\n      <h2>三档套餐，按你的用量选</h2>\n      <p class=\"sub\">先看每月流量和同时在线设备数，这两项决定了大多数人的选择。价格随时可能调整，请以页面显示为准。</p>\n      <div class=\"rule\"></div>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15 <small>/ 月</small></div>\n        </div>\n        <p class=\"annual\">年付 ¥150/年，相当于按十个月计。</p>\n        <ul>\n          <li>每月 100GB 流量</li>\n          <li>3 台设备同时在线</li>\n          <li>基础流媒体解锁</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan pick\">\n        <div class=\"plan-head\">\n          <h3>旗舰版</h3>\n          <span class=\"badge\">多数人合适</span>\n          <div class=\"price\">¥35 <small>/ 月</small></div>\n        </div>\n        <p class=\"annual\">年付 ¥350/年，相当于按十个月计。</p>\n        <ul>\n          <li>每月 300GB 流量</li>\n          <li>5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n          <li>适合手机加电脑一起用</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>团队版</h3>\n          <div class=\"price\">¥85 <small>/ 月</small></div>\n        </div>\n        <p class=\"annual\">年付 ¥850/年，相当于按十个月计。</p>\n        <ul>\n          <li>每月 1000GB 流量</li>\n          <li>20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n    </section>\n\n    <section id=\"clients\">\n      <h2>客户端：你用什么设备，就走哪条路</h2>\n      <p class=\"sub\">火云加速按平台区分使用方式。下面只写各平台的接入形态和需要注意的地方，下载入口与版本号不在本页公布。</p>\n      <div class=\"rule\"></div>\n\n      <div class=\"client-grid\">\n        <div class=\"card\">\n          <h3>Windows 桌面端</h3>\n          <p>常见的桌面接入方式，适合长时间在线的工作场景。安装后登录账号即可按套餐使用，流量与设备数受套餐限制。</p>\n          <p>建议在系统盘外的位置安装，便于后续更新覆盖。</p>\n        </div>\n        <div class=\"card\">\n          <h3>macOS 桌面端</h3>\n          <p>面向 Mac 电脑的桌面客户端，界面与 Windows 版本保持同一套账号体系，切换设备时需注意同时在线数量上限。</p>\n          <p>如遇系统权限提示，属正常的网络配置请求，按提示确认即可。</p>\n        </div>\n        <div class=\"card\">\n          <h3>Android 移动端</h3>\n          <p>手机端以应用形式接入，适合通勤、外出时使用。移动网络下流量消耗比 Wi-Fi 更容易被忽略，建议留意用量。</p>\n        </div>\n        <div class=\"card\">\n          <h3>iOS 移动端</h3>\n          <p>iPhone 与 iPad 上通过对应的客户端形态接入，账号与桌面端通用。系统版本要求请以客户端页面说明为准。</p>\n        </div>\n      </div>\n\n      <p class=\"note\">本页不提供安装包下载地址与版本号。各平台的可用形态、系统要求与更新记录，请以品牌正式渠道的说明为准；如你看到的信息与本页不一致，以后者为准。</p>\n    </section>\n\n    <section id=\"howto\">\n      <h2>怎么开始用：四步</h2>\n      <p class=\"sub\">流程本身不复杂，麻烦的通常是第一步选档。先把用量估个大概，后面就顺了。</p>\n      <div class=\"rule\"></div>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"no\">01</div>\n          <div>\n            <h3>先估一个月的用量</h3>\n            <p>把常用设备的日常流量加一加：手机刷视频、电脑开会、平板看剧。估出来在 100GB 以内选基础版，300GB 上下选旗舰版，多人共用再考虑团队版。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"no\">02</div>\n          <div>\n            <h3>数一数同时在线的设备</h3>\n            <p>同时在线数量和流量是两道独立的门槛。家里三台手机加两台电脑，就已经超过基础版的 3 台上限，这时该看旗舰版。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"no\">03</div>\n          <div>\n            <h3>在你常用的设备上装好客户端</h3>\n            <p>按上面对应平台的说明安装，登录同一个账号。第一次用时先跑一段日常操作，看看线路是否顺手，再决定要不要长期用。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"no\">04</div>\n          <div>\n            <h3>用一周，再回来看用量</h3>\n            <p>头一周的用量最能说明问题。如果离上限还很远，往下调档也行；如果接近满额，就该往上走一档，别等到月中被卡住。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"notes\">\n      <h2>选购前，这几件事值得先知道</h2>\n      <p class=\"sub\">不是免责声明，是我们希望你在付钱之前就弄清楚的三件事。</p>\n      <div class=\"rule\"></div>\n\n      <div class=\"card\">\n        <h3>流量按自然月重置</h3>\n        <p>套餐内的每月流量以自然月为周期计算，未用完的部分不结转到下个月。用量大的月份，建议提前看余额，而不是等提示。</p>\n      </div>\n      <div class=\"card\">\n        <h3>同时在线数是硬上限</h3>\n        <p>超出设备数后，新设备无法同时接入，需要先退出其中一台。这不是速度问题，是席位问题，所以第一步就要数清设备。</p>\n      </div>\n      <div class=\"card\">\n        <h3>年付更省，但周期更长</h3>\n        <p>年付按十个月计价，确实比月付划算，代价是一次锁定一年。如果你是第一次用，先按月付跑一段时间，觉得合适再换年付，风险更小。</p>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <h2>常见问题</h2>\n      <p class=\"sub\">下面这些是被问得最多的。点开看答案，没找到你的问题，就按正式渠道去问。</p>\n      <div class=\"rule\"></div>\n\n      <details>\n        <summary>基础版 100GB 一个月够用吗？</summary>\n        <div class=\"ans\">\n          <p>看你怎么用。以文字为主、偶尔看短视频、开会不多的话，100GB 通常有余量；如果每天都长时间看高清视频，或者要传大文件，基础版会吃紧。</p>\n          <p>比较稳妥的做法是第一个月先选基础版，用一周看看实际消耗，再决定要不要升档。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>三档套餐的主要差别是什么？</summary>\n        <div class=\"ans\">\n          <p>两条主线：每月流量和同时在线设备数。基础版 100GB／3 台，旗舰版 300GB／5 台，团队版 1000GB／20 台。</p>\n          <p>此外旗舰版和团队版在节点类型上更多一些，团队版还额外提供定制路由和专属客户经理。价格分别是每月 ¥15、¥35、¥85。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>我一个人用，需要团队版吗？</summary>\n        <div class=\"ans\">\n          <p>一般不需要。团队版面向的是多人或多设备共用的情况，比如小团队一起办公、家里设备特别多。</p>\n          <p>单人日常使用，旗舰版在流量和设备数上通常已经够用，价格也低不少。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>年付和月付有什么区别？</summary>\n        <div class=\"ans\">\n          <p>费用周期不同，价格也不同。基础版年付 ¥150/年，旗舰版 ¥350/年，团队版 ¥850/年，都相当于按十个月计。</p>\n          <p>能否中途变更周期、如何续费，本页不做承诺，请以正式渠道的规则为准。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>在哪里下载客户端？</summary>\n        <div class=\"ans\">\n          <p>本页不提供下载地址，也不提供版本号。上文只说明各平台的使用形态和注意事项。</p>\n          <p>获取安装包请走品牌正式渠道；如果对来源有疑问，宁可不装，也不要从来路不明的第三方站点取文件。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>同时在线设备数超出了会怎样？</summary>\n        <div class=\"ans\">\n          <p>超出上限时，新设备无法同时接入，需要先在其中一台已登录的设备上退出，把席位让出来。</p>\n          <p>长期设备数不够用，就往上调一档，这是最省心的处理方式。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>用起来不顺手，能退吗？</summary>\n        <div class=\"ans\">\n          <p>本页没有提供退款政策的具体条款，也不代为承诺。付款前请先确认正式渠道公布的规则。</p>\n          <p>如果不确定是否合适，先按月付试一段时间，是比较稳妥的做法。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>流量用完了还能继续用吗？</summary>\n        <div class=\"ans\">\n          <p>套餐内的每月流量用完后，当月的额度即告用尽，需等到下一个计费周期重置。</p>\n          <p>提前留意用量，比事后处理更省事。用量稳定的用户，直接选高一档往往更划算。</p>\n        </div>\n      </details>\n    </section>\n\n    <footer>\n      <span>火云加速（huoyunjs）</span>\n      <span>本页为服务说明展示，含套餐价格与客户端形态描述</span>\n      <span>未提供下载地址、交易入口与退款条款</span>\n    </footer>\n\n  </main>\n</div>",
